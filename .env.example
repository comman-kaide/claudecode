PORT=3000

# OpenAI (for subtitle generation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (for AI Secretary)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Slack Bot (Socket Mode)
# 1. https://api.slack.com/apps で新しいアプリを作成
# 2. Socket Mode を有効化 → App-Level Token を取得
# 3. OAuth & Permissions で Bot Token Scopes を追加:
#    - chat:write, app_mentions:read, im:history, im:read, im:write, commands
# 4. Event Subscriptions で以下を登録:
#    - message.im, app_mention
# 5. Slash Commands で /secretary を作成
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-level-token
